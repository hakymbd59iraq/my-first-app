<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>بوصلة القبلة</title><link rel="manifest" href="manifest.json"><style>body{margin:0;background:#000;color:#fff;font-family:sans-serif;text-align:center;height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center} #compass{width:280px;height:280px;border:6px solid #d4af37;border-radius:50%;position:relative;margin:20px} #arrow{position:absolute;left:50%;top:10%;width:4px;height:45%;background:#d4af37;transform-origin:bottom center;transition:0.1s} #kaaba{position:absolute;left:50%;top:5px;transform:translateX(-50%);font-size:30px} #qibla-dot{position:absolute;width:16px;height:16px;background:#0f0;border-radius:50%;left:50%;top:50%;transform-origin:center -120px} #info{color:#d4af37;margin-top:15px} button{background:#d4af37;color:#000;border:0;padding:12px 25px;border-radius:25px;font-size:18px;font-weight:bold}</style></head><body><h2>🕋 بوصلة القبلة</h2><div id="compass"><div id="kaaba">🕋</div><div id="arrow"></div><div id="qibla-dot"></div></div><div id="info">اضغط للبدء</div><button id="start">ابدأ البوصلة</button><script>
let qibla=0; const kaabaLat=21.3891, kaabaLng=39.8579;
function calcQibla(lat,lng){let phiK=kaabaLat*Math.PI/180, lambdaK=kaabaLng*Math.PI/180, phi=lat*Math.PI/180, lambda=lng*Math.PI/180; let y=Math.sin(lambdaK-lambda); let x=Math.cos(phi)*Math.tan(phiK)-Math.sin(phi)*Math.cos(lambdaK-lambda); qibla=Math.atan2(y,x)*180/Math.PI; document.getElementById('info').innerText='القبلة: '+qibla.toFixed(1)+'°';}
navigator.geolocation.getCurrentPosition(p=>calcQibla(p.coords.latitude,p.coords.longitude),()=>{calcQibla(35.557,45.435);},{enableHighAccuracy:true});
document.getElementById('start').onclick=async()=>{document.getElementById('start').style.display='none'; if(typeof DeviceOrientationEvent.requestPermission==='function'){await DeviceOrientationEvent.requestPermission();} window.addEventListener('deviceorientation',e=>{let heading=e.webkitCompassHeading||(360-e.alpha); if(heading==null)return; let diff=qibla-heading; document.getElementById('arrow').style.transform=`translateX(-50%) rotate(${diff}deg)`; if(Math.abs(diff)<5||Math.abs(diff)>355){document.getElementById('info').innerHTML='<span style=color:#0f0;font-size:22px>✅ باتجاه القبلة</span>';}},true);};
if('serviceWorker' in navigator){navigator.serviceWorker.register('sw.js');}
</script></body></html>
