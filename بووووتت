//+------------------------------------------------------------------+
//|  بوت الفيديو - فكرة التيك الحقيقية                             |
//|  صعود=شراء فقط هبوط=بيع فقط + فتح كل تيك + ستوب يلاحق كل تيك |
//+------------------------------------------------------------------+
#property strict
#include <Trade/Trade.mqh>
CTrade trade;

input double Lot = 0.01;
input int    Open_Every_Ticks = 10;  // كل 10 نقاط = 0.10$ يفتح صفقة جديدة
input int    Trail_Every_Ticks = 10; // كل 10 نقاط يحرك الستوب
input int    Stop_Distance = 60;     // الستوب بعيد 60 نقطة = 0.60$ عن السعر
input int    Magic = 123;

double lastPrice=0;

int OnInit() { trade.SetExpertMagicNumber(Magic); return INIT_SUCCEEDED; }

void OnTick()
{
   double ask = SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol,SYMBOL_BID);
   double pt = SymbolInfoDouble(_Symbol,SYMBOL_POINT)*10;
   
   if(lastPrice==0) { lastPrice=ask; return; }

   //--- 1. الستوب يلاحق كل تيك مثل الفيديو
   for(int i=0;i<PositionsTotal();i++)
   {
      if(PositionGetSymbol(i)!=_Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=Magic) continue;
      long ticket=PositionGetInteger(POSITION_TICKET);
      long type=PositionGetInteger(POSITION_TYPE);
      double sl=PositionGetDouble(POSITION_SL);
      
      if(type==POSITION_TYPE_BUY)
      {
         double shouldBeSL = bid - Stop_Distance*pt;
         // اذا تحرك السعر Trail_Every_Ticks يحرك الستوب
         if(sl==0 || (shouldBeSL - sl) >= Trail_Every_Ticks*pt)
            trade.PositionModify(ticket,shouldBeSL,0);
      }
      else
      {
         double shouldBeSL = ask + Stop_Distance*pt;
         if(sl==0 || (sl - shouldBeSL) >= Trail_Every_Ticks*pt)
            trade.PositionModify(ticket,shouldBeSL,0);
      }
   }

   //--- 2. يفتح كل تيك حسب الاتجاه - نفس الفيديو بالضبط
   double move = ask - lastPrice;
   
   if(MathAbs(move) >= Open_Every_Ticks*pt)
   {
      if(move > 0)
      {
         // صاعد = شراء فقط مثل ما كلت
         trade.Buy(Lot,_Symbol,ask,ask - Stop_Distance*pt,0);
      }
      else
      {
         // هابط = بيع فقط
         trade.Sell(Lot,_Symbol,bid,bid + Stop_Distance*pt,0);
      }
      lastPrice = ask;
   }
   
   //--- اول مرة
   if(PositionsTotal()==0 && lastPrice!=0)
   {
      // شوف اول حركة وين وافتح
      if(ask >= lastPrice) trade.Buy(Lot,_Symbol,ask,ask - Stop_Distance*pt,0);
      else trade.Sell(Lot,_Symbol,bid,bid + Stop_Distance*pt,0);
   }
}
